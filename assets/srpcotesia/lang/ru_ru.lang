tooltip.srpcotesia.scorned_pearl.parasite3=§4ЛУЧШЕ ЧТОБЫ ОНА БЫЛА СДЕЛАНА ИЗ НАШЕЙ ПЛОТИ, ЧЕМ ИЗ ЧЕГО-ТО МЕНЕЕ МАЛОДУШНОГО.
