tooltip.srpcotesia.factory_drop2=§4ТВОИ "МОДИФИКАЦИИ", ОБЛЕЧЁННЫЕ В ФОРМУ. ИЗМЕНЕНИЯ В ТАКОЙ СТЕПЕНИ ИМЕЮТ ПОСЛЕДСТВИЯ, ДЛЯ НАС И ДЛЯ ТВОИХ ТВОРЕНИЙ.
tooltip.srpcotesia.factory_drop3=§4БЫЛО БЫ МУДРО СКРЫТЬ НАШИ СЛЕДЫ. ИЗБАВЬСЯ ОТ ЭТОГО.

