tooltip.srpcotesia.callous_chip3=§4УБЕДИТЬ ДРУГИХ ИЗГОТОВИТЬ ИХ БЫЛО ТЩЕТНОЙ ПОПЫТКОЙ. МЫ САМИ ПО СЕБЕ.

